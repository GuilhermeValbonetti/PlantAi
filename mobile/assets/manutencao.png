e hover:no-underline inline-flex items-center justify-center focus-visible:ring focus-visible:ring-offset-2 focus-visible:ring-primary-hover !px-2 text-sm !h-[2.5rem] !py-2 text-white !bg-primary hover:!bg-primary-hover active:!bg-primary-active !bg-transparent hover:!bg-transparent active:!bg-transparent text-primary hover:!text-primary-hover text-base w-full md:w-auto"><div class="[&amp;&gt;svg]:shrink-0 flex items-center"><span class="flex !px-2">Cancelar</span></div></button></div></div></form></dialog></form></dialog><!----><div data-v-2d43fb67="" id="mobileDrawerSpace" class="lg:hidden" style="height: 176px;"></div></div><!----></div></div></div></main> <div class="vue-component" data-vue-file="./desktop_app_overlay.vue" data-vue-props="{&quot;t&quot;:&quot;{\&quot;header\&quot;:\&quot;Cansado de carregar arquivo por arquivo?\&quot;,\&quot;text\&quot;:\&quot;Processe a quantidade de arquivos que quiser com apenas um clique.\&quot;,\&quot;link\&quot;:\&quot;Adquira o remove.bg para Windows\&quot;}&quot;,&quot;link&quot;:&quot;/pt-br/windows-mac-linux&quot;,&quot;icon&quot;:&quot;https://static.remove.bg/remove-bg-web/c1c849c74092c3eb09308367c3f2f1eaba6e96cd/assets/batch-8c16cc3d37b4fed06625795493206efb180b02dfce3af2ae614d84bf106ccd52.svg&quot;}" data-vue-on="{}" data-v-app=""><div data-v-e026b23b=""><!----></div></div> <div class="prism d-none-mobile-app"></div> <div id="improvedialog-popup" class="white-popup mfp-hide" data-controller="improvedialog" style="max-width: 580px;"><h3 class="text-center" style="margin: -20px -20px 25px; padding: 20px 20px 15px; background: rgb(236, 241, 249);">
    Obrigado pelo seu feedback!
  </h3> <div data-target="improvedialog.initial"><p class="lead">
      Quer nos ajudar a melhorar? <span style="opacity: 0.5;">(opcional)</span></p> <ul style="list-style-type: none; padding-left: 0px;"><li><i class="fas fa-arrow-right" style="margin-right: 5px;"></i>
        Contribua essa imagem e ajude-nos a melhorar ainda mais o remove.bg
      </li> <li><i class="fas fa-arrow-right" style="margin-right: 5px;"></i>
        Ensinar a Inteligência Artificial
      </li> <li><i class="fas fa-arrow-right" style="margin-right: 5px;"></i>
        Obtenha resultados melhores em imagens parecidas no futuro
      </li></ul> <div style="font-size: 80%; margin-top: 15px;"><label data-target="improvedialog.terms" style="font-weight: 300;"><input type="checkbox">
        Eu concordo com <a target="_blank" href="https://www.remove.bg/pt-br/ipc" style="color: inherit; text-decoration: underline;">Condições do Programa de Melhoria</a>.*
      </label> <label data-target="improvedialog.remember" style="font-weight: 300;"><input type="checkbox">
        Lembrar da minha opção para imagens que eu avaliar negativamente no futuro
      </label></div> <div class="row" style="text-align: center;"><div class="col-md-6"><button class="btn btn-outline-primary" data-action="click-&gt;improvedialog#accept" style="margin-top: 15px;">
          Sim, contribuir imagem
        </button> <div style="font-size: 75%; opacity: 0.75;">
